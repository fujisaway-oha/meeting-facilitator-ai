# 社内LANアクセス用の簡易パスワード（初期値: 1234）
APP_PASSCODE=1234
APP_SECRET_KEY=please-change-this-secret-key
APP_PORT=8000

# ホスト側の Ollama を参照（Mac / Linux 共通）
OLLAMA_BASE_URL=http://host.docker.internal:11434

# コンテナ内の VOICEVOX Engine 設定（3 = ずんだもんノーマル、2 = 四国めたんノーマル 等）
VOICEVOX_BASE_URL=http://voicevox:50021
VOICEVOX_SPEAKER_ID=3

# ローカル音声認識 faster-whisper 設定（一般PC: small/cpu, GB10: large-v3-turbo/cuda）
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
